{$SITE_DOMAIN} {
  encode zstd gzip
  reverse_proxy app:3000
}

# CowAgent web console, deployed separately from lrmcorp/lrmagents onto the lnint-edge network.
# AGENT_DOMAIN is a host list separated by ", ", e.g. lrmcorporation.id, www.lrmcorporation.id.
{$AGENT_DOMAIN:agent.lnint.xyz} {
  encode zstd gzip
  # WhatsApp Cloud API webhook, served by lrmagents' whatsapp-bridge.
  handle /whatsapp/webhook {
    reverse_proxy whatsapp-bridge:8080
  }
  handle {
    reverse_proxy cowagent:9899
  }
}
